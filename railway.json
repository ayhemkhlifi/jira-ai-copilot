{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m src.api.server",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicy": "ON_FAILURE",
    "numReplicas": 1
  }
}
