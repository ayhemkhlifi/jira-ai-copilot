# =============================================================================
# Jira AI Copilot - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to git!
# =============================================================================

# --- App Deployment ---
# Your public HTTPS URL (Railway/Render will give you one)
APP_BASE_URL=https://your-app.up.railway.app
API_PORT=8000

# --- LLM Provider ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-medium
MISTRAL_API_KEY=your-mistral-api-key-here

# --- Embeddings (Local HuggingFace) ---
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe

# --- Qdrant Vector Database ---
# For local development:
#   QDRANT_URL=http://localhost:6333
#   QDRANT_API_KEY=
# For Qdrant Cloud (production):
#   QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
#   QDRANT_API_KEY=your-qdrant-api-key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=jira_copilot_nomic

# --- RAG Configuration ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=8

# --- Data Paths ---
DATA_DIR=data

# --- Jira Cloud API ---
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
